{
  "name": "softomedia-live2026",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "cd ad-server && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "npx cross-env ALLOW_DEMO_MODE=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mock": "playwright test --grep-invert @seed",
    "test:e2e:seed": "npx cross-env ALLOW_DEMO_MODE=true playwright test --grep @seed",
    "pretest:e2e": "node scripts/test-preflight.js",
    "test:rules": "firebase emulators:exec --project softomedia-demo --only firestore \"npx jest tests/firestore-rules/\"",
    "lint": "node scripts/lint-tests.js && cd ad-server && npm run lint && cd ../client-app && npm run lint",
    "db:seed": "cd ad-server && npm run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.57.0",
    "dotenv": "^17.4.2",
    "firebase-tools": "^15.22.0",
    "jest": "^30.4.2"
  }
}
