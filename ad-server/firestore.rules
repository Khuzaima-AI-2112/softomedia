rules_version = '2';

// Deny-by-default: every Softomedia read and write traverses the authenticated
// Express API, which uses privileged server credentials and applies the explicit
// role and organization permissions. No browser, device, or signed-in Firebase
// user may access Firestore directly, regardless of token claims.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
