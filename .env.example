# Environment Variables Template
# Copy this file to .env.development for local development

# Backend API URL (used by client-app)
VITE_API_URL=http://localhost:8080

# JWT Secret (REQUIRED - generate a secure random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
NODE_ENV=development

# Port Configuration
PORT=8080
CLIENT_PORT=5173

# Demo Mode — set to true to enable the Bearer demo-token bypass in auth.js.
# REQUIRED for local E2E (Playwright demo-wizard project) and Cloud Run staging.
# NEVER set this in production — auth.js blocks demo mode when NODE_ENV=production
# regardless of this flag.
ALLOW_DEMO_MODE=true

# Dedicated demo reset target. Set both project values to the same dedicated
# demo project; reset refuses missing or mismatched values.
GOOGLE_CLOUD_PROJECT=replace-with-dedicated-demo-project-id
DEMO_PROJECT_ID=replace-with-dedicated-demo-project-id
# Must be the demo project's Firebase default bucket:
# <DEMO_PROJECT_ID>.appspot.com or <DEMO_PROJECT_ID>.firebasestorage.app
DEMO_ASSETS_BUCKET=replace-with-dedicated-demo-project-id.appspot.com

# Supplied only when explicitly provisioning the seven prepared Firebase users.
# Deliver the real value through a secure channel; never commit it.
DEMO_ACCOUNT_PASSWORD=
