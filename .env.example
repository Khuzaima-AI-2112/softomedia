# Environment Variables Template
# Copy this file to .env.development for local development

# Backend API URL (used by client-app)
VITE_API_URL=http://localhost:8080

# JWT Secret (REQUIRED - generate a secure random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
NODE_ENV=development

# Port Configuration
PORT=8080
CLIENT_PORT=5173

# Demo Mode — set to true to enable the Bearer demo-token bypass in auth.js.
# REQUIRED for local E2E (Playwright demo-wizard project) and Cloud Run staging.
# NEVER set this in production — auth.js blocks demo mode when NODE_ENV=production
# regardless of this flag.
ALLOW_DEMO_MODE=true

# Google Cloud Project (for production)
# PROJECT_ID=softomedia-live2026
