rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user has a specific role
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: Users can read/write their own profile
    // Admins can read/write all
    match /users/{userId} {
      allow read, write: if isOwner(userId) || hasRole('admin');
    }

    // Locations: 
    // - Public read (for players to find settings? maybe restricted)
    // - Owner can read/update
    // - Admin can do all
    match /locations/{locationId} {
      allow read: if (isAuthenticated() && resource.data.owner_id == request.auth.uid) || hasRole('admin');
      allow write: if hasRole('admin'); // Only admins create locations initially
      allow update: if (isAuthenticated() && resource.data.owner_id == request.auth.uid) || hasRole('admin');
    }

    // Screens:
    // - Location owners can read their screens
    // - Screens (the devices) need access? usually they use a separate auth or just public ID check in backend
    //   For now, we assume backend proxied access or standard auth.
    match /screens/{screenId} {
      allow read: if (isAuthenticated() && resource.data.owner_id == request.auth.uid) || hasRole('admin');
      allow write: if hasRole('admin'); // Only admins register screens? or Location owners?
      // Let's allow location owners to update settings
      allow update: if (isAuthenticated() && resource.data.owner_id == request.auth.uid) || hasRole('admin');
    }

    // Advertisers:
    // - Can read own profile
    match /advertisers/{advertiserId} {
      allow read: if (isAuthenticated() && resource.data.primary_contact_user_id == request.auth.uid) || hasRole('admin');
      allow write: if hasRole('admin');
    }

    // Campaigns:
    // - Advertisers can read/write their own campaigns
    match /campaigns/{campaignId} {
      allow read, write: if (isAuthenticated() && resource.data.advertiser_id == request.auth.uid) || hasRole('admin');
      allow create: if isAuthenticated() && hasRole('advertiser'); // Allow creation if backend validates ownership
    }
    
    // Ads:
    // - Advertisers can read/write their own ads
    match /ads/{adId} {
      allow read, write: if (isAuthenticated() && resource.data.advertiser_id == request.auth.uid) || hasRole('admin');
    }

    // Retailers:
    // - Retailer owners can read their own profile
    // - Admins can read/write all
    match /retailers/{retailerId} {
      allow read: if (isAuthenticated() && resource.data.owner_user_id == request.auth.uid) || hasRole('admin');
      allow write: if hasRole('admin');
      allow update: if (isAuthenticated() && resource.data.owner_user_id == request.auth.uid); // Can update own profile
    }

    // Brands:
    // - Brand owners can read their own profile
    // - Admins can read/write all
    match /brands/{brandId} {
      allow read: if (isAuthenticated() && resource.data.owner_user_id == request.auth.uid) || hasRole('admin');
      allow write: if hasRole('admin');
      allow update: if (isAuthenticated() && resource.data.owner_user_id == request.auth.uid);
    }

    // Invitations:
    // - Users can read invitations sent to their email
    // - Admins can create invitations
    match /invitations/{inviteId} {
      allow read: if (isAuthenticated() && resource.data.email == request.auth.token.email) || hasRole('admin');
      allow create: if hasRole('admin');
      allow update: if hasRole('admin'); // For marking as accepted/expired
    }

    // Earnings:
    // - Retailers can read their own earnings
    // - Only system (admin) writes earnings
    match /earnings/{earningId} {
      allow read: if (isAuthenticated() && resource.data.retailer_id == request.auth.token.linked_entity_id) || hasRole('admin');
      allow write: if hasRole('admin');
    }

    // Screen Locations:
    // - Public read for map display
    // - Admins can write
    match /screen_locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
